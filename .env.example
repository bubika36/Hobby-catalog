# Copy this file to .env and fill in the values. .env is in .gitignore, so it is never committed.

# Sent to Nominatim (OpenStreetMap's geocoder) with every address lookup for the club map.
# Their usage policy asks for the app's name and a way to contact you: an e-mail or the project's URL.
# https://operations.osmfoundation.org/policies/nominatim/
GEOCODER_USER_AGENT="AppName/1.0 (your e-mail or the project's URL)"
